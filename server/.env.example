# ---- SparkAgent server configuration (copy to server/.env) ----

# Shared secret: the client must present the same value. Generate any long random string.
AGENT_TOKEN=change-me-to-a-long-random-string

# Listen address. 0.0.0.0 makes the server reachable from other machines.
HOST=0.0.0.0
PORT=8700

# OpenCode Go ($10/mo, https://opencode.ai/zen/go/v1, Responses API). All text roles —
# dialogue agent, executor, router — and media calls use Muse Spark 1.3 Contributor.
# Server-side defaults per role — the client overrides them from its settings:
# LLM_MODEL = dialogue agent + executor, ROUTER_MODEL = the request classifier,
# LLM_MEDIA_MODEL = any call that carries images / screenshots (multimodal input).
# Key: /connect in the OpenCode app -> auth.json "opencode-go" key -> paste below.
OPENCODE_API_KEY=paste-opencode-go-key-here
GO_BASE_URL=https://opencode.ai/zen/go/v1
GO_MODEL=muse-spark-1.3-contributor
LLM_MODEL=muse-spark-1.3-contributor
LLM_MEDIA_MODEL=muse-spark-1.3-contributor
ROUTER_MODEL=muse-spark-1.3-contributor
# LLM_PROXY=socks5h://127.0.0.1:2080
LLM_THINKING=false
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
DIALOGUE_MAX_TOKENS=1200
# NVIDIA NIM (build.nvidia.com) is kept only for the memory embeddings below.
NVIDIA_API_KEY=nvapi-...
EMBED_TEXT_MODEL=nvidia/nemotron-3-embed-1b
EMBED_VL_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2

# Attachments go straight into the model. ffmpeg (on PATH or a full path here) converts any audio/video
# to what the model takes (mp3 / mp4 <= 2 min); without it only wav, mp3 and mp4 files are sent as they are.
FFMPEG=ffmpeg
MEDIA_IMAGE_MAX_SIDE=1600
MEDIA_AUDIO_MAX_S=1200
MEDIA_VIDEO_MAX_S=120
MEDIA_KEEP_TURNS=2

# Live context budget (older turns drop out of the model context; the client keeps them in its memory)
CONTEXT_BUDGET_TOKENS=60000
CONTEXT_KEEP_TURNS=6

# web_search: a search API key makes results real (free tiers exist); without one the tool falls back to
# Bing's RSS feed, which is weak for Russian queries. The first configured key is used.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
# optional proxy for web_search / fetch_page, e.g. http://127.0.0.1:2080
WEB_PROXY=

# The server keeps nothing on disk: uploads live in RAM only while a client uses them (seconds since last use)
UPLOAD_MAX_MB=100
UPLOAD_TTL_S=7200
LOG_LEVEL=info
